  "escrita": {
    "travessao_proibido": true,
    "idioma": "pt-BR",
    "regras": "Português brasileiro com diacríticos, sem traço longo nem meia-risca, sem emoji."
  },
  "marca": {
    "regra_texto": "A marca é \"fX\" (f minúsculo, X maiúsculo), nunca \"FX\", \"Fx\" ou \"fx\". Produtos: \"fX Loja\", \"fX Loja+\" e \"fX Pagamentos\".",
    "preservar_caixa": ["fX"],
    "reprovar": [
      {
        "padrao": "{{ANTES}}(FX|Fx|fx)(?![\\w/.@-])",
        "mensagem": "marca escrita \"FX\", \"Fx\" ou \"fx\". A grafia é \"fX\""
      }
    ],
    "normalizar": [
      {
        "padrao": "{{ANTES}}f\\s?x\\s?loja\\s?\\+",
        "ignorar_caixa": true,
        "para": "fX Loja+",
        "aceitar": ["fX Loja+"]
      },
      {
        "padrao": "{{ANTES}}f\\s?x\\s?loja(?!\\s?\\+)",
        "ignorar_caixa": true,
        "para": "fX Loja",
        "aceitar": ["fX Loja"]
      },
      {
        "padrao": "{{ANTES}}f\\s?x\\s?pagamentos",
        "ignorar_caixa": true,
        "para": "fX Pagamentos",
        "aceitar": ["fX Pagamentos"]
      }
    ]
  },
  "areas": [
    { "nome": "Dados", "cor": "#0EA5E9", "padrao": "^\\s*dados\\s*:", "vence_no_prefixo": true },
    { "nome": "fX Loja", "cor": "#2563EB", "padrao": "{{ANTES}}f\\s?x\\s?loja" },
